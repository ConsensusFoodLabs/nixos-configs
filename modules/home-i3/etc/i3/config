# A conventional i3 configuration.
#
# This is the default every i3 machine gets, and it is deliberately close to
# stock i3: numbered workspaces, standard bindings, no modes of its own. The
# point is that someone who has used i3 before can sit down and work, and
# someone who has not can read `man i3` and have it describe this file.
#
# Personal habits do not belong here. To use your own, put it in
# users/<name>/etc/i3/config and point at it from your home.nix:
#
#   home.file.".config/i3/config".source = ./etc/i3/config;
#
# The shared layer sets this with lib.mkDefault, so that override needs no
# mkForce. users/oleg is a worked example.
#
# Screen locking is NOT configured here. xss-lock and xautolock are declared
# at the system level in profiles/engineering.nix, because a lock this file
# could remove would not be a control (D14). The binding below only asks
# logind to lock; it cannot disable locking.

set $mod Mod4

font pango:monospace 8
focus_follows_mouse no
default_border pixel 1
default_floating_border pixel 1

# XDG autostart
exec --no-startup-id dex --autostart --environment i3

# Compositor, notifications, the network applet and the polkit agent are
# services, not exec lines — see modules/home-i3 and profiles/engineering.nix.

# Terminal. i3-sensible-terminal honours $TERMINAL, which modules/home-i3
# sets; override TERMINAL in your own home.nix to change it.
bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+Shift+q kill

# Launcher, emoji picker, power menu.
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+i exec --no-startup-id rofi -modi emoji -show emoji
bindsym $mod+Shift+e exec --no-startup-id rofi-powermenu

# Lock now. Goes through logind so xss-lock runs the locker and the session is
# marked locked; running the locker directly would leave logind disagreeing.
bindsym $mod+Shift+x exec --no-startup-id loginctl lock-session

# Volume. wpctl, not pactl or amixer: the machine runs PipeWire with
# WirePlumber, and wpctl is the one that is always present.
bindsym XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec --no-startup-id wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# Brightness. xbacklight here is acpilight's sysfs implementation.
bindsym XF86MonBrightnessUp   exec --no-startup-id xbacklight -inc 10
bindsym XF86MonBrightnessDown exec --no-startup-id xbacklight -dec 10

# Dismiss notifications
bindsym Control+Shift+space exec --no-startup-id dunstctl close

# Screenshots. Each copies to the clipboard and writes a dated PNG under
# ~/Pictures/screenshots.
bindsym Print       exec --no-startup-id screenshot screen
bindsym Shift+Print exec --no-startup-id screenshot select
bindsym $mod+Print  exec --no-startup-id screenshot window

floating_modifier $mod
tiling_drag modifier titlebar

# Focus. h/j/k/l as in vim — left, down, up, right. i3's own defaults are
# j/k/l/semicolon, which almost nobody keeps.
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+Shift+Left  move left
bindsym $mod+Shift+Down  move down
bindsym $mod+Shift+Up    move up
bindsym $mod+Shift+Right move right

# Split. $mod+b rather than i3's $mod+h, which is taken by focus-left above.
bindsym $mod+b split h
bindsym $mod+v split v

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces, numbered 1-10.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Move a whole workspace between monitors.
bindsym $mod+Shift+greater move workspace to output right
bindsym $mod+Shift+less    move workspace to output left

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

mode "resize" {
        bindsym h resize shrink width 10 px or 10 ppt
        bindsym j resize grow height 10 px or 10 ppt
        bindsym k resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Left  resize shrink width 10 px or 10 ppt
        bindsym Down  resize grow height 10 px or 10 ppt
        bindsym Up    resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

bar {
        status_command i3blocks
        font pango:JetBrainsMono Nerd Font 10
        # onedark, matching ~/.config/rofi/colors.rasi.
        colors {
                background #1E2127
                statusline #FFFFFF
                separator  #282B31
        }
}
