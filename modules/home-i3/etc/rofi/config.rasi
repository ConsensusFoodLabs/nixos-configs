/**
 * rofi configuration for oleg.
 *
 * Theme ported from adi1090x/rofi (MIT), launchers/type-1/style-4 with the
 * onedark palette — the same one this machine's predecessor ran. It is
 * inlined across three files here rather than vendoring the upstream tree,
 * which is some 200 files of themes, scripts and wallpapers (D33).
 */

configuration {
	modi: "drun,run,filebrowser,window";
	case-sensitive: false;
	cycle: true;
	scroll-method: 0;
	normalize-match: true;
	steal-focus: false;

	matching: "normal";
	tokenize: true;

	drun-match-fields: "name,generic,exec,categories,keywords";
	drun-display-format: "{name}";
	drun-show-actions: false;
	window-format: "{w} · {c} · {t}";

	terminal: "ghostty";
	kb-cancel: "Escape,super+d";
}

@theme "~/.config/rofi/launcher.rasi"
