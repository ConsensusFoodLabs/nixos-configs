# Generate the provisioning secrets for one machine and commit them encrypted.
#
# Run on an administrator's workstation, from a checkout of this repository:
#
#     nix run .#fleet-mksecrets -- x1c-oleg
#
# The output is fleet/secrets/<host>.yaml, encrypted to the age recipients in
# .sops.yaml. It is safe to commit to this public repository; that is the
# point (D24). Review the diff and open a PR as usual.

set -euo pipefail

usage() {
    cat >&2 <<'MSG'
usage: fleet-mksecrets <hostname> [--rotate | --add-missing]

  --rotate        Replace every secret for this host with a new value.
  --add-missing   Keep every existing value and generate only the ones that
                  are absent. Use this when a new field has been introduced
                  and a machine's file predates it — rotating instead would
                  replace a recovery key that is already enrolled on a disk.

Rotation invalidates nothing on its own: a machine already installed keeps the
keyslots it was built with. Rotating means the *next* install uses new values,
and that the old ones must be removed from the machine by hand. See
docs/provisioning.md.
MSG
    exit 2
}

host=""
rotate=0
add_missing=0
while (($#)); do
    case "$1" in
        --rotate) rotate=1 ;;
        --add-missing) add_missing=1 ;;
        -h | --help) usage ;;
        -*) echo "fleet-mksecrets: unknown option $1" >&2; usage ;;
        *)
            [[ -z $host ]] || { echo "fleet-mksecrets: one hostname at a time" >&2; usage; }
            host=$1
            ;;
    esac
    shift
done
[[ -n $host ]] || usage
((rotate && add_missing)) && {
    echo "fleet-mksecrets: --rotate and --add-missing are opposites" >&2
    usage
}

die_no_key() {
    echo "fleet-mksecrets: $*" >&2
    echo "Set SOPS_AGE_KEY_FILE, or link your identity in as .admin-key." >&2
    exit 1
}

root=$(git rev-parse --show-toplevel)
cd "$root"

# One path, whatever is behind it. .admin-key is gitignored and normally a
# symlink to a USB stick or wherever the identity really lives, so every admin
# refers to their key the same way without the repository knowing where it is
# (D25). direnv exports this too; setting it here keeps the script working
# without direnv, and an explicit SOPS_AGE_KEY_FILE still wins.
if [[ -z ${SOPS_AGE_KEY_FILE:-} && -e .admin-key ]]; then
    export SOPS_AGE_KEY_FILE="$root/.admin-key"
fi

# The sentinel in .sops.yaml is not a usable recipient, and sops fails on it
# with an unhelpful bech32 error. Say what is actually wrong.
if grep -q 'age1REPLACEMEWITHAREALADMINPUBLICKEY' .sops.yaml; then
    cat >&2 <<'MSG'
fleet-mksecrets: .sops.yaml still contains the placeholder recipient.

No administrator key exists yet, so there is nobody who could decrypt what
this would produce. Create one:

    age-keygen -o /path/to/removable/media/fleet-admin-key.txt
    ln -s /path/to/removable/media/fleet-admin-key.txt .admin-key

Put the printed public key in .sops.yaml. Keep the identity itself off this
machine's disk and back it up offline: losing every admin identity means
losing every machine's recovery key (D25).
MSG
    exit 1
fi

# The inventory decides which machines exist (D3, D13).
if ! nix eval --json --impure \
    --expr "builtins.attrNames (import $root/fleet/inventory.nix).devices" |
    grep -q "\"$host\""; then
    echo "fleet-mksecrets: '$host' is not a device in fleet/inventory.nix." >&2
    echo "Add it there first — the configuration is generated from the inventory." >&2
    exit 1
fi

outfile="fleet/secrets/$host.yaml"
if [[ -e $outfile ]] && ((!rotate && !add_missing)); then
    echo "fleet-mksecrets: $outfile already exists." >&2
    echo "Pass --add-missing to fill in newly added fields, or --rotate to" >&2
    echo "replace everything — having read what that does: $0 --help" >&2
    exit 1
fi
if ((add_missing)) && [[ ! -e $outfile ]]; then
    echo "fleet-mksecrets: $outfile does not exist; nothing to add to." >&2
    exit 1
fi

# Base32: 5 bits per character, and the alphabet already excludes 0/1/8/9, so
# there is nothing ambiguous to mistype. These get typed by hand at a LUKS
# prompt with no clipboard and no feedback, which is the whole design
# constraint.
randgroups() {
    local groups=$1 len=$2 out="" i
    for ((i = 0; i < groups; i++)); do
        [[ -z $out ]] || out+="-"
        out+=$(dd if=/dev/urandom bs=64 count=1 status=none |
            base32 | tr -d '=\n' | cut -c "1-$len")
    done
    printf '%s' "$out"
}

# With --add-missing, every value already present is carried across untouched.
# That matters most for luks_recovery_key: it is enrolled on a real disk, and
# replacing it here would leave this file describing escrow that does not work
# (D31).
existing=""
if ((add_missing)); then
    existing=$(sops decrypt --output-type json "$outfile") ||
        die_no_key "cannot decrypt $outfile, so existing values cannot be preserved"
fi

kept=() added=()

# Sets REPLY rather than printing, so it can be called without a command
# substitution. In a subshell the kept/added arrays would be discarded and the
# report would silently come back empty.
gen_or_keep() { # field, groups, length
    local have=""
    if [[ -n $existing ]]; then
        have=$(jq -r --arg k "$1" '.[$k] // empty' <<<"$existing")
    fi
    if [[ -n $have ]]; then
        REPLY=$have
        kept+=("$1")
    else
        REPLY=$(randgroups "$2" "$3")
        added+=("$1")
    fi
}

gen_or_keep luks_passphrase 5 5; luks_passphrase=$REPLY            # 125 bits — typed at every boot until changed
gen_or_keep luks_recovery_key 8 5; recovery_key=$REPLY             # 200 bits — organization-held, typed almost never
gen_or_keep admin_password 5 4; admin_password=$REPLY              # 100 bits — sudo and console for the shared admin
gen_or_keep user_initial_password 4 4; initial_password=$REPLY     #  80 bits — changed at first login

mkdir -p fleet/secrets
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

# --filename-override makes the .sops.yaml creation rule match, so the content
# is encrypted to the right recipients even though it arrives on stdin and
# never touches the disk in plaintext. The result is written aside and moved
# into place, so a failure here cannot leave a half-written secrets file.
cat <<EOF | sops encrypt --filename-override "$outfile" /dev/stdin > "$tmp"
# Provisioning secrets for $host. Generated $(date -u +%Y-%m-%dT%H:%M:%SZ).
#
# Encrypted at rest; see .sops.yaml for who can read it. These are INITIAL
# credentials — the machine ships with them and the developer replaces the
# passphrase and password on day one (D27). The recovery key is not initial:
# it is the organization's standing access to the disk and it does not expire
# (D5).
luks_passphrase: "$luks_passphrase"
luks_recovery_key: "$recovery_key"
admin_password: "$admin_password"
user_initial_password: "$initial_password"
EOF

# Encryption only needs public keys, so this would happily produce a file that
# nobody present can read — including the person who just made it. Prove the
# round trip *before* anything is moved into place: with --rotate, failing
# after the move would have destroyed the old secrets and replaced them with
# ones nobody can open.
if [[ -e ${SOPS_AGE_KEY_FILE:-/nonexistent} ]]; then
    if sops decrypt --input-type yaml --output-type json "$tmp" >/dev/null 2>&1; then
        verified="verified: your key decrypts it"
    else
        echo "fleet-mksecrets: YOUR key does not decrypt what was just built." >&2
        echo >&2
        echo "Your public key is probably not among the recipients in .sops.yaml." >&2
        echo "Nothing was written; $outfile is unchanged." >&2
        exit 1
    fi
elif [[ -L .admin-key ]]; then
    verified="NOT verified: .admin-key points at something not currently present
(removable media unplugged?), so the round trip was not tested."
else
    verified="NOT verified: no .admin-key, so the round trip was not tested.
Link one:  ln -s /path/to/your/fleet-admin-key.txt .admin-key"
fi

mv "$tmp" "$outfile"
chmod 0644 "$outfile"

echo "wrote $outfile"
((${#kept[@]})) && echo "  kept:  ${kept[*]}"
((${#added[@]})) && echo "  added: ${added[*]}"
echo "$verified"

echo
echo "Verify it is actually encrypted before committing:"
echo "    grep -c 'ENC\[' $outfile"
echo "    sops decrypt $outfile"
echo
echo "Then commit and open a PR. Nothing is printed here on purpose — read the"
echo "values with 'sops decrypt' when you need them."
