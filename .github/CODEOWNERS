# Review tiers. See docs/access-control.md.
#
# Nobody merges their own changes to shared configuration.
#
# NOTE: these team names are placeholders until the GitHub teams exist. A
# CODEOWNERS entry naming a team that does not exist silently enforces nothing.

# Default: shared configuration, tight review.
*                       @ConsensusFoodLabs/fleet-admins

# Hardware, shared system config, and the inventory — including administrator
# grants, which is why this file is not developer-editable (D12).
/fleet/                 @ConsensusFoodLabs/fleet-admins
/hosts/                 @ConsensusFoodLabs/fleet-admins
/profiles/              @ConsensusFoodLabs/fleet-admins
/modules/               @ConsensusFoodLabs/fleet-admins
/flake.nix              @ConsensusFoodLabs/fleet-admins
/flake.lock             @ConsensusFoodLabs/fleet-admins
/.githooks/             @ConsensusFoodLabs/fleet-admins
/.github/               @ConsensusFoodLabs/fleet-admins
/scripts/               @ConsensusFoodLabs/fleet-admins
/tests/                 @ConsensusFoodLabs/fleet-admins

# Who can decrypt every machine's key material, and the key material itself.
# Changing .sops.yaml changes who holds the fleet's recovery keys, which makes
# it the single most sensitive file here (D25).
/.sops.yaml             @ConsensusFoodLabs/fleet-admins
/fleet/secrets/         @ConsensusFoodLabs/fleet-admins

# Per-developer configuration: light review.
/users/                 @ConsensusFoodLabs/engineering
