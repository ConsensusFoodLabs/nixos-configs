#!/usr/bin/env bash
# The active NetworkManager connection: SSID and signal for wifi, the
# interface name for anything else. Click to open the applet's editor.
set -euo pipefail

case "${BLOCK_BUTTON:-}" in
  1) nm-connection-editor >/dev/null 2>&1 & ;;
esac

# nmcli -t escapes colons in fields, so ask for one field at a time.
device=$(nmcli -t -f DEVICE,STATE device status | awk -F: '$2 == "connected" { print $1; exit }')

if [[ -z $device ]]; then
  echo "NET down"
  echo "down"
  echo "#cc241d"
  exit 0
fi

if [[ -d /sys/class/net/$device/wireless ]]; then
  ssid=$(nmcli -t -f ACTIVE,SSID,SIGNAL device wifi list ifname "$device" |
    awk -F: '$1 == "yes" { print $2 " " $3; exit }')
  echo "WIFI ${ssid:-$device}"
  echo "${ssid:-$device}"
else
  echo "NET $device"
  echo "$device"
fi
