/**
 * Power menu: a small centred dialog, not the side panel.
 *
 * From adi1090x/rofi (MIT), powermenu/type-1/style-1.
 */

@import "~/.config/rofi/colors.rasi"

configuration {
    show-icons: false;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    fullscreen:       false;
    width:            400px;
    x-offset:         0px;
    y-offset:         0px;

    enabled:          true;
    margin:           0px;
    padding:          0px;
    border:           0px solid;
    border-radius:    12px;
    border-color:     @selected;
    cursor:           "default";
    background-color: @background;
}

mainbox {
    enabled:          true;
    spacing:          10px;
    margin:           0px;
    padding:          20px;
    border:           0px solid;
    border-color:     @selected;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

inputbar {
    enabled:          true;
    spacing:          10px;
    padding:          8px;
    border-radius:    6px;
    background-color: @background-alt;
    text-color:       @foreground;
    children:         [ "prompt", "entry" ];
}

prompt {
    background-color: inherit;
    text-color:       @selected;
}

entry {
    background-color: inherit;
    text-color:       inherit;
    placeholder:      "";
}

listview {
    enabled:          true;
    columns:          1;
    lines:            5;
    cycle:            true;
    dynamic:          true;
    scrollbar:        false;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;

    spacing:          5px;
    margin:           0px;
    padding:          0px;
    border:           0px solid;
    border-color:     @selected;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           "default";
}

element {
    enabled:          true;
    spacing:          0px;
    margin:           0px;
    padding:          10px;
    border:           0px solid;
    border-radius:    10px;
    border-color:     @selected;
    background-color: transparent;
    text-color:       @foreground;
    cursor:           pointer;
}

element selected.normal {
    background-color: @selected;
    text-color:       @background;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

message {
    enabled:          true;
    background-color: transparent;
    text-color:       @foreground;
}

textbox {
    padding:          8px;
    border-radius:    6px;
    background-color: @background-alt;
    text-color:       @foreground;
    vertical-align:   0.5;
    markup:           true;
}
