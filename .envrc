# Point sops at the administrator identity, for anyone using direnv.
#
# .admin-key is gitignored and is normally a symlink to wherever the key
# actually lives — a USB stick, a password manager's mount, ~/.config. The
# repository refers to one path; each admin decides what is behind it (D25).
#
#     ln -s /run/media/$USER/<stick>/fleet-admin-key.txt .admin-key
#     direnv allow
#
# Without direnv, do the same by hand:
#     export SOPS_AGE_KEY_FILE="$PWD/.admin-key"

if [ -e .admin-key ]; then
    export SOPS_AGE_KEY_FILE="$PWD/.admin-key"
elif [ -L .admin-key ]; then
    echo "note: .admin-key is a symlink to something not currently present" >&2
    echo "      (removable media unplugged?) — sops will not find your key" >&2
fi
